{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Flask App",
            "type": "python",
            "request": "launch",
            "module": "flask",
            "env": {
                "FLASK_APP": "main.py",
                "FLASK_ENV": "development"
            },
            "args": [
                "run",
                "--host=127.0.0.1",
                "--port=8000"
            ],
            "jinja": true,
            "console": "integratedTerminal"
        }
    ]
}
